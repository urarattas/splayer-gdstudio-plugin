{
  "name": "splayer-gdstudio-plugin",
  "version": "1.2.0",
  "private": true,
  "description": "SPlayer-Next 音源插件：官方网易云拿不到地址时用 GD Studio 接管播放地址，默认 hi-res，歌词封面保持官方 (GD Studio API source plugin for SPlayer-Next)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check src/plugin.js && node --check dist/gdstudio.splayer-source.js",
    "check:dist": "node scripts/check-dist.mjs",
    "check:artifact": "node scripts/check-artifact.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  }
}
